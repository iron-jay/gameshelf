# Copy to .env and fill in. .env is gitignored.

# --- database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://gameshelf:change-me@localhost:5432/gameshelf

# --- IGDB (Twitch OAuth client credentials) ---
# https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- SteamGridDB ---
# https://www.steamgriddb.com/profile/preferences/api
SGDB_API_KEY=

# --- app ---
# openssl rand -base64 32
SESSION_SECRET=
ORIGIN=http://localhost:3000

# Skip sign-in entirely. For a single-user server on a network you trust:
# anything that can reach the port can read, edit and delete without a
# password. The admin user below still has to exist; you just walk past it.
AUTH_DISABLED=false

# Where downloaded cover art is written. Absolute in the container,
# repo-relative in dev so it lands under the gitignored ./data.
COVERS_DIR=/absolute/path/to/gameshelf/data/covers

# --- the first user (read once, when the database is empty) ---
# The name can be changed later in Settings; this only ever applies to
# creating the account, never to an existing one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- container ports (compose only) ---
# Both services bind to 127.0.0.1 by default. Change these only if the reverse
# proxy lives on another host, or something already owns the port.
# APP_BIND=127.0.0.1
# APP_PORT=3000
# DB_BIND=127.0.0.1
# DB_PORT=5432

# --- images (compose only) ---
# Pin to a commit sha to deploy something other than the newest build, or point
# the whole thing somewhere else entirely.
# GAMESHELF_IMAGE=ghcr.io/iron-jay/gameshelf
# GAMESHELF_TAG=latest
